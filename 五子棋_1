void play(void){
	int count,round,result;
	int row,col;
	int lastHuman_r=-1;
	int lastHuman_c=-1;
	int lastCom_r=-1;
	int lastCom_c=-1;
	for(count=0;count<size*size;count++){
		round=count%2;
		
		if(round==0){ 
			scanf("%d %d",&row,&col);
			while(row < 1 || row > size || col < 1 || col > size || board[row-1][col-1] != -1){
		    	printf("输入无效或该格已下过，请重新输入 1~%d：\n", size);
		   		scanf("%d %d", &row, &col);
			}
			lastHuman_r=row-1;
			lastHuman_c=col-1;
			board[row-1][col-1]=1;
			draw(lastHuman_r,lastHuman_c);
		}
		else if(round==1){
			computerMove(&lastCom_r,&lastCom_c);  
			draw(lastCom_r,lastCom_c);
		}

		if(round == 0){
		    result = judge(lastHuman_r, lastHuman_c, board[lastHuman_r][lastHuman_c]);
		}else{
		    result = judge(lastCom_r, lastCom_c, board[lastCom_r][lastCom_c]);
		}
		if(result==0){
			printf(" o 胜利！\n");
			return;
		}else if(result==1){
			printf(" x 胜利！\n");
			return;
		}
	}
	printf("平局\n");
}

void computerMove(int *plastRow, int *plastCol){
    int bestScore=-1,score=0;
    int bestRow=-1,bestCol=-1;
    int myScore,yourScore;
    for( int row=0; row<size; row++ ){
    	for( int col=0; col<size; col++ ){
    		if( board[row][col]!=-1 ) continue;
    		myScore=evaluatePosition(row,col,0);
    		yourScore=evaluatePosition(row,col,1);
			score=myScore+yourScore*5/10;
			if( score>bestScore ){
				bestScore=score;
				bestRow=row;
				bestCol=col;
			}
		}
	}

    *plastRow = bestRow;
    *plastCol = bestCol;
    board[*plastRow][*plastCol] = 0;
    
}

//在上一个电脑落子的附近九宫格寻找空位 
int findNearEmpty(int *pRow, int *pCol, int lastRow, int lastCol){//pRow ~ 随机的行坐标   lastRow ~ 上一次落子 
	int row,col;
	for( row=lastRow-1 ; row<=lastRow+1 ; row++ ){
		for( col=lastCol-1 ; col<=lastCol+1 ; col++ ){
			if( row< 0 || row >= size || col < 0 || col >= size) continue;
			if(board[row][col]==-1){
				*pRow=row;
				*pCol=col;
				return 1;		//找到了空位 
			}
		}
	}
	return 0;
}



int evaluateDirection(int r,int c,int piece,int d){
	int dx[4]={0,1,1,-1};
	int dy[4]={1,0,1,1};
	int k,nr,nc;
	
	int cnt=1;  //自己的
	int openEnds=0;  //开放端 
	
	//正方向 
	for(k=1;k<5;k++){
		nr=r+dx[d]*k;
		nc=c+dy[d]*k;
		
		if(nr<0||nr>=size||nc<0||nc>=size)  break;
		if( board[nr][nc] == piece )		cnt++;
		else if( board[nr][nc] == -1 )	  { openEnds++; break; } 
		else break;    	//对方棋 
	}
	//反方向 
	for(k=1;k<5;k++){
		nr=r-dx[d]*k;
		nc=c-dy[d]*k;
		
		if(nr<0||nr>=size||nc<0||nc>=size)  break;
		if( board[nr][nc] == piece )		cnt++;
		else if( board[nr][nc] == -1 )	  { openEnds++; break; } 
		else break;    	//对方棋 
	}
	
		// 根据 count 和 openEnds 给分
    if(cnt >= 5) return 100000;
    if(cnt == 4){
        if(openEnds == 2) return 10000;   // 活四
        if(openEnds == 1) return 1000;    // 冲四
        return 0;
    }
    if(cnt == 3){
        if(openEnds == 2) return 1000;    // 活三
        if(openEnds == 1) return 500;     // 眠三
        return 0;
    }
    if(cnt == 2){
        if(openEnds == 2) return 100;     // 活二
        if(openEnds == 1) return 10;      // 眠二
        return 0;
    }
    if(cnt == 1) return 1;
    return 0;
}

int evaluatePosition( int row ,int col ,int piece ){
	int score=0;
	for( int d=0 ; d<4 ; d++ ){
		score+=evaluateDirection( row, col, piece, d );
	}
	return score;
}
