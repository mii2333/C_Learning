void ini(void){
	int i,j;
	for(i=0;i<size;i++){
		for(j=0;j<size;j++){
			board[i][j]=-1;  //-1=空 0=o 1=x 
		}
	}
}

int judge(int r,int c,int piece){
	int dx[4]={0,1,1,-1};
	int dy[4]={1,0,1,1};
	int d,k,nr,nc,cnt;

	for(d=0;d<4;d++){
	cnt=1; 
		//正方向 
		for(k=1;k<5;k++){
			nr=r+dx[d]*k;
			nc=c+dy[d]*k;
			
			if(nr<0||nr>=size||nc<0||nc>=size){
				break;
			}
			if(board[nr][nc]!=piece){
				break;
			}
			cnt++;
		}
		//反方向 
		for(k=1;k<5;k++){
			nr=r-dx[d]*k;
			nc=c-dy[d]*k;
			
			if(nr<0||nr>=size||nc<0||nc>=size){
				break;
			}
			if(board[nr][nc]!=piece){
				break;
			}
			cnt++;
		}
		if(cnt>=5){
			return piece;/*返回五连的棋子类型 */
		}
	}
	
	return -1;
}


