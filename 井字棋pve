void play(int choice){
	
	int cnt;
	for(cnt=1;cnt<10;cnt++){
		if(choice==1){					//玩家先手 
			if( cnt%2==1 ){
				humanMove(); 
			}
			else if( cnt%2==0 ){
				computerMove();
			}
		}else{
			if( cnt%2==0 ){
				humanMove(); 
			}
			else if( cnt%2==1 ){
				computerMove();
			}
		}

		
		//打印棋盘 
		printBoard();
		
		//判断胜负 
		int result=judge();
		if(result!=-1){
			printf("___________________________________\n");
			if(result==0){
				Sleep(500);
				printf("我赢了，耶！菜就多练\n"); 
			}else if(result==1){
				Sleep(500);
				printf("你赢了，恭喜！\n"); 
			}
			return;
		}
		
	}
	Sleep(500);
	printf("我们平局\n");
}

//判断 
int judge(void){
	
	int i,j;
	int x=0,o=0;//o~number of 0  ,  x~ number of 1
	//判断行
	for(i=0;i<size;i++){
		x=o=0;
		for(j=0;j<size;j++){
			if(mat[i][j]==0){
				o++;
			}else if(mat[i][j]==1){
				x++;
			}
		}
		if( x==size ){
			return 1;
		}
		if( o==size ){
			return 0;
		}
	}
	
	//判断列 
	for(j=0;j<size;j++){
		x=o=0;
		for(i=0;i<size;i++){
			if(mat[i][j]==0){
				o++;
			}else if(mat[i][j]==1){
				x++;
			}
		}
		if( x==size ){
			return 1;
		}
		if( o==size ){
			return 0;
		}
	}
	
	//判断对角线
	x=o=0;
	for(i=0;i<size;i++){
		if(mat[i][i]==0){
			o++;
		}else if(mat[i][i]==1){
			x++;
		}
	}
	if( x==size ){
		return 1;
	}
	if( o==size ){
		return 0;
	}
	
	x=o=0;
	for(i=0;i<size;i++){
		if(mat[i][size-1-i]==0){
			o++;
		}else if(mat[i][size-1-i]==1){
			x++;
		}
	}
	if( x==size ){
		return 1;//玩家赢 
	}
	if( o==size ){
		return 0;
	}
	
	
	return -1;//平局 
}
//玩家行动 
void humanMove(void){

	Sleep(500);
	printf("轮到你了，请输入第__行，第__列\n");
		//读入+校验 （仅player） 
		int i,j; 
		scanf("%d %d", &i, &j);
		while( i<1 || i>3 || j<1 || j>3 || mat[i-1][j-1] != -1 ){
    		printf("输入无效或该格已下过，请重新输入1~3组成的坐标\n");
    		scanf("%d %d", &i, &j);
		}
		i--;
		j--;
		mat[i][j] = 1;
}

//打印棋盘 
void printBoard(void){
	int i,j;
	
	for(i=0;i<size;i++){
		printf("+---+---+---+\n");
		printf("|");
		for(j=0;j<size;j++){
			if(mat[i][j]==-1){
				printf("   |");
			}else if(mat[i][j]==1){
				printf(" X |");
			}else if(mat[i][j]==0){
				printf(" O |");
			}
		}	
		printf("\n");
	}
	printf("+---+---+---+\n");
	return; 
}

//电脑行动 
