}
/*

1 随便选一个格下（假装是人或电脑）
2 judge 返回谁赢 
	judge()=0电脑赢 break 进入3
	1玩家赢  break 留下ij坐标 进入3  
	-1平局 
3 下在ij坐标上 
4  随机 
*/
int tryonce( int piece ,int *row ,int *col ){
	int result,a,b;
	for( a=0;a<size;a++ ){
		for( b=0;b<size;b++ ){
			if(mat[a][b]!=-1) {
				continue;
			}	
			mat[a][b]=piece;
			result=judge();
			mat[a][b]=-1;
			
			if(result==piece){
				*row=a;
				*col=b;
				return 1;
			}
		}	
	}
	return 0;
}
