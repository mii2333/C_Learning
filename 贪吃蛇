#include<stdio.h>
#include<stdlib.h>
#include<conio.h>
#include<windows.h>
#include<time.h>

#define WALL 1
#define EMPTY 0
#define rowLen 20 
#define colLen 60 
#define UP 'w'
#define DOWN 's'
#define LEFT 'a'
#define RIGHT 'd'
#define QUIT 'q'

typedef struct Node{
	
	int row;
	int col;
	struct Node* next;
	
}Node;

typedef struct Snake{
	
	Node* head;
	Node* tail;
	char direction;	// 行进方向
	int len; // 蛇长度 
	
}Snake;

int map[rowLen][colLen];

void Map(void);
void draw( Snake* psnake );
Node* createNode( int row, int col );
void add( Snake* psnake,int row, int col ); 
void printSnake(Snake* s);

//void move( Snake* psnake );

int input( Snake* psnake ){
	if( _kbhit() ){
	
	    char key=getch();
	
	    if(key==UP ||
	       key==DOWN ||
	       key==LEFT ||
	       key==RIGHT ||
	       key==QUIT)
	    {
	        if( key == QUIT ){
	        	return 1;
			}
			else if(1 /*不是反方向*/ ){
				psnake->direction=key;
				return 0;
			}
	    }
	}
	
}

void move( Snake* psnake ){
	
		Node* pretail=NULL;
		Node* p=psnake->head;
		while( p->next != NULL ){
			pretail=p;
			p=p->next;
		}
		pretail->next=NULL;
		psnake->tail->next=psnake->head;
		
		switch( psnake->direction ){
			case UP:	psnake->tail->row=psnake->head->row-1;
						psnake->tail->col=psnake->head->col;
						break;
			case DOWN:	psnake->tail->row=psnake->head->row+1;
						psnake->tail->col=psnake->head->col;
						break;
			case LEFT:	psnake->tail->row=psnake->head->row;
						psnake->tail->col=psnake->head->col-1;
						break; 
			case RIGHT:	psnake->tail->row=psnake->head->row;
						psnake->tail->col=psnake->head->col+1;
						break; 
		}
			
		psnake->head=psnake->tail;
		psnake->tail=pretail;
		

} 

int main(){
	
	Snake snake={0};
	snake.direction=RIGHT;
	for( int i=0; i<3 ; i++ ){
		add(&snake,rowLen/2,colLen/2-i);// 初始化蛇 
	}
	
	Map();	

	while ( 1 ){
		draw(&snake);
		if( input(&snake) ){
			return 0;
		}
		move(&snake);

	}
}

void Map(void){
	for( int i=0; i<rowLen; i++ ){
		for( int j=0; j<colLen; j++ ){
			map[i][j]=EMPTY;
			map[i][0]=WALL;
			map[i][colLen-1]=WALL;
			map[0][j]=WALL;
			map[rowLen-1][j]=WALL;
		}
	} 
}
	
void draw( Snake* psnake ){
	Sleep(100);
	system("cls");
	int flag;
	for( int i=0; i<rowLen; i++ ){
		for( int j=0; j<colLen; j++ ){
			flag=0;
			for( Node* p = psnake->head; p; p=p->next ){
					if( p->row == i && p->col == j ){
						flag=1;	
				 }
			}
			if( map[i][j]== WALL ){
				printf("#");
			}else if( flag == 1) {
				printf("o");
				
			}else if( map[i][j]== EMPTY ){
				printf(" "); 
			}
		}
		printf("\n");
	} 
}

Node* createNode( int row, int col )
{
	Node* newNode=(Node*)malloc(sizeof(Node));

	if(newNode==NULL)
	{
		printf("fail to malloc\n");
		return NULL;
	}

	newNode->row=row;
	newNode->col=col;
	newNode->next=NULL;

	return newNode;
}

void add( Snake* psnake,int row, int col )
{
	Node* newNode=createNode(row,col);

	if(newNode==NULL)
	{
		return;
	}


	if( psnake->head == NULL )
	{
		psnake->head = newNode;
		psnake->tail = newNode;
	}
	else
	{
		psnake->tail->next = newNode;
		psnake->tail = newNode;
	}
	psnake->len++;
}

void printSnake(Snake* s)
{
    Node* p=s->head;

    while(p)
    {
        printf("(%d,%d)->",p->row,p->col);
        p=p->next;
    }

    printf("NULL\n");
}
